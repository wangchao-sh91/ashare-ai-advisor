# Runtime
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# DeepSeek-compatible model provider (keep credentials server-side)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.example.invalid/v1
DEEPSEEK_MODEL=provider-model-id
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Doubao search provider (protocol details remain configurable)
DOUBAO_SEARCH_API_KEY=
DOUBAO_SEARCH_BASE_URL=https://search.example.invalid
DOUBAO_SEARCH_TIMEOUT_SECONDS=20
DOUBAO_SEARCH_MAX_RETRIES=2

# AKShare and in-process cache
AKSHARE_TIMEOUT_SECONDS=20
AKSHARE_MAX_RETRIES=2
MARKET_DATA_CACHE_TTL_SECONDS=300

# Direct-development browser origin. Use a comma-separated list when needed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
