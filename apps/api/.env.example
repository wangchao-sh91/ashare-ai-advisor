# Runtime
APP_ENV=development
PROVIDER_MODE=real
BIND_MODE=direct
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# DeepSeek-compatible model provider (keep credentials server-side)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Tushare free daily-price provider
TUSHARE_TOKEN=
TUSHARE_TIMEOUT_SECONDS=20
TUSHARE_MAX_RETRIES=1
TUSHARE_MAX_WORKERS=4
PRICE_CACHE_TTL_SECONDS=21600

# Doubao Search Custom HTTPS API (server-side API key)
DOUBAO_SEARCH_API_KEY=
DOUBAO_SEARCH_ENDPOINT=https://open.feedcoopapi.com/search_api/web_search
DOUBAO_SEARCH_TIMEOUT_SECONDS=20
DOUBAO_SEARCH_MAX_RETRIES=2
DOUBAO_SEARCH_MAX_CONCURRENCY=4
DOUBAO_SEARCH_RESULT_COUNT=5
CORPORATE_EVENT_CACHE_TTL_SECONDS=1800
FINANCIAL_SEARCH_CACHE_TTL_SECONDS=86400
INDEX_SEARCH_CACHE_TTL_SECONDS=3600
PROVIDER_CACHE_MAX_ENTRIES=512

# Direct-development browser origin. Use a comma-separated list when needed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
