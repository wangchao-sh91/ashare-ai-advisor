# Runtime
APP_ENV=development
PROVIDER_MODE=real
BIND_MODE=direct
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# DeepSeek-compatible model provider (keep credentials server-side)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Doubao SearchInfinity MCP provider (API key or AK/SK; do not configure both)
DOUBAO_SEARCH_API_KEY=
DOUBAO_SEARCH_ACCESS_KEY=
DOUBAO_SEARCH_SECRET_KEY=
DOUBAO_SEARCH_TRANSPORT=stdio
DOUBAO_SEARCH_TIMEOUT_SECONDS=20
DOUBAO_SEARCH_MAX_RETRIES=2

# AKShare and in-process cache
AKSHARE_TIMEOUT_SECONDS=20
AKSHARE_MAX_RETRIES=2
AKSHARE_MAX_WORKERS=4
MARKET_DATA_CACHE_TTL_SECONDS=300

# Direct-development browser origin. Use a comma-separated list when needed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
